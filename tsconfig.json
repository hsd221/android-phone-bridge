{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": "dist",
    "rootDir": "bridge/src",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["bridge/src/**/*.ts"]
}
