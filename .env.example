# First startup writes these settings and a random Harness token to the data volume.
# Later changes belong in /data/bridge.config.json; existing credentials are preserved.
BRIDGE_PUBLIC_URL=https://phone-bridge.example.com
BRIDGE_BIND_ADDRESS=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_ALLOW_INSECURE_LAN=false
# Optional: use a prebuilt image instead of the local Docker build.
# PHONE_BRIDGE_IMAGE=your-registry/phone-bridge:version
